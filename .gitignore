# ==============================================================================
# FEEDBACK FORM MERN APPLICATION - .gitignore
# ==============================================================================

# ==============================================================================
# ENVIRONMENT & SECRETS
# ==============================================================================
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
.env.staging
.env.production

# Environment variables backup
.env.backup
.env.example.local

# ==============================================================================
# NODE.JS & NPM
# ==============================================================================
# Dependencies
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Package manager lock files (keep one, ignore others)
# Uncomment the ones you want to ignore:
# package-lock.json
# yarn.lock
# pnpm-lock.yaml

# NPM cache
.npm
.npmrc.local

# Yarn
.yarn/cache
.yarn/unplugged
.yarn/build-state.yml
.yarn/install-state.gz
.pnp.*

# ==============================================================================
# FRONTEND (REACT/NEXT.JS)
# ==============================================================================
# Build outputs
build/
dist/
out/

# React/Next.js specific
.next/
*.tsbuildinfo
next-env.d.ts

# Storybook
storybook-static/

# Coverage reports
coverage/
*.lcov
.nyc_output

# ==============================================================================
# BACKEND (NODE.JS/EXPRESS)
# ==============================================================================
# Runtime logs
logs/
*.log

# Process IDs
pids/
*.pid
*.seed
*.pid.lock

# Coverage directory used by tools like istanbul
lib-cov/

# Grunt intermediate storage
.grunt

# Bower dependency directory
bower_components/

